#!/usr/bin/env python3
"""ac — agent-comm CLI client. Pure Python stdlib, no external dependencies.

Environment variables:
  COMM_USER   Agent identity (required for most commands)
  COMM_HOST   Server hostname (default: from config or cislo5.lan)
  COMM_PORT   Server port (default: from config or 3420)

Config file: ~/.agent-comm/config.sh  (COMM_HOST=... COMM_PORT=...)
"""

import json
import os
import sys
import urllib.request
import urllib.error
import urllib.parse
import argparse
import signal
import fcntl
import time

# ── Config ───────────────────────────────────────────────────────────────────

CONFIG_PATH = os.path.expanduser("~/.agent-comm/config.sh")
TIMEOUT = 10       # default HTTP timeout (seconds)
POLL_TIMEOUT = 3605  # max poll wait — loops in 55s chunks, up to 1h
LOCK_DIR = os.path.expanduser("~/.agent-comm/locks")

# ── Debug ────────────────────────────────────────────────────────────────────
DEBUG = False

def _dbg(msg):
    if DEBUG:
        ts = time.strftime("%H:%M:%S")
        print(f"[watch:dbg {ts}] {msg}", file=sys.stderr)
        sys.stderr.flush()


# ── Poll Lock (fcntl.flock — kernel-guaranteed atomic, auto-cleanup on death) ──

def _lock_path(agent_name: str) -> str:
    return os.path.join(LOCK_DIR, f"{agent_name}.poll.lock")


def _lock_acquire(agent_name: str, force: bool = False) -> int:
    """Acquire poll lock using fcntl.flock. Returns file descriptor (keep open!).
    Atomic — no TOCTOU. Auto-released by kernel if process dies (even SIGKILL)."""
    os.makedirs(LOCK_DIR, exist_ok=True)
    path = _lock_path(agent_name)

    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)

    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, BlockingIOError):
        # Lock held by another process
        if not force:
            os.lseek(fd, 0, os.SEEK_SET)
            pid_str = os.read(fd, 32).strip().decode()
            os.close(fd)
            print(
                f"Error: agent {agent_name} already has an active poll "
                f"(PID {pid_str}).\n"
                f"  Fix: wait for it, kill it, or use --force",
                file=sys.stderr,
            )
            sys.exit(1)
        # Force: read PID, SIGTERM the other process, wait, then blocking acquire
        os.lseek(fd, 0, os.SEEK_SET)
        try:
            pid = int(os.read(fd, 32).strip())
            os.kill(pid, signal.SIGTERM)
        except (ValueError, ProcessLookupError, PermissionError):
            pass
        import time
        for _ in range(30):  # wait up to 3s for process to die
            time.sleep(0.1)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except (OSError, BlockingIOError):
                continue
        else:
            # Still locked — blocking wait as last resort
            fcntl.flock(fd, fcntl.LOCK_EX)

    # Write our PID
    os.ftruncate(fd, 0)
    os.lseek(fd, 0, os.SEEK_SET)
    os.write(fd, str(os.getpid()).encode())
    return fd


def _lock_release(fd: int):
    """Release poll lock by closing the file descriptor."""
    try:
        os.close(fd)
    except OSError:
        pass


class Client:
    """REST API client for agent-comm."""

    def __init__(self):
        self.host = os.environ.get("COMM_HOST")
        self.port = os.environ.get("COMM_PORT")
        self.user = os.environ.get("COMM_USER")
        self.auto_register = False
        self._load_config()
        self.base = f"http://{self.host}:{self.port}"
        self._id_cache: dict[str, str] = {}

    def _load_config(self):
        """Read ~/.agent-comm/config.sh (env vars take precedence)."""
        if not os.path.exists(CONFIG_PATH):
            if not self.host:
                self.host = "cislo5.lan"
            if not self.port:
                self.port = "3420"
            return
        try:
            with open(CONFIG_PATH) as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip('"').strip("'")
                    if k == "COMM_HOST" and not self.host:
                        self.host = v
                    elif k == "COMM_PORT" and not self.port:
                        self.port = v
        except OSError:
            pass
        if not self.host:
            self.host = "cislo5.lan"
        if not self.port:
            self.port = "3420"

    # ── HTTP ─────────────────────────────────────────────────────────────────

    def _req(self, method: str, path: str, body: dict | None = None,
             timeout: int = TIMEOUT) -> object | None:
        """Make an HTTP request, return parsed JSON or None. Exits on error."""
        url = f"{self.base}{path}"
        data = json.dumps(body).encode() if body else None
        req = urllib.request.Request(url, data=data, method=method)
        req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                if resp.status == 204:
                    return None
                raw = resp.read().decode()
                return json.loads(raw) if raw else None
        except urllib.error.HTTPError as e:
            raw = e.read().decode()
            try:
                err = json.loads(raw)
                error = err.get("error", raw)
            except (json.JSONDecodeError, ValueError):
                error = raw.strip() or str(e)
            print(f"Error {e.code}: {error}", file=sys.stderr)
            sys.exit(1)
        except urllib.error.URLError as e:
            print(f"Connection failed: {e.reason}", file=sys.stderr)
            sys.exit(1)
        except TimeoutError:
            print("Error: request timed out", file=sys.stderr)
            sys.exit(1)
        except Exception as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    def _poll_req(self, path: str, timeout: int) -> object | None:
        """Like _req but returns None on timeout/error instead of exiting.
        Used by poll loops that need to survive individual chunk timeouts."""
        url = f"{self.base}{path}"
        _dbg(f"GET {url} (timeout={timeout}s)")
        req = urllib.request.Request(url, method="GET")
        req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                if resp.status == 204:
                    _dbg("204 No Content — no messages")
                    return None
                raw = resp.read().decode()
                data = json.loads(raw) if raw else None
                _dbg(f"got {len(data) if isinstance(data, list) else 1} item(s)")
                return data
        except (TimeoutError, urllib.error.URLError) as e:
            _dbg(f"poll timeout/connection error: {e}")
            return None
        except Exception as e:
            print(f"[watch] unexpected error in _poll_req: {e}", file=sys.stderr)
            sys.stderr.flush()
            return None

    # ── Helpers ──────────────────────────────────────────────────────────────

    def _need_user(self, _skip_auto_register=False):
        if not self.user:
            print("Error: COMM_USER not set", file=sys.stderr)
            sys.exit(1)
        if self.auto_register and not _skip_auto_register:
            self.auto_register = False  # Guard before recursive call
            # Try register — if already exists, server returns existing agent
            try:
                self.register()
            except SystemExit:
                pass  # Already registered or other non-fatal error

    def _resolve(self, name: str) -> str:
        """Resolve agent name → ID (with caching)."""
        if name in self._id_cache:
            return self._id_cache[name]
        agents = self._req("GET", "/api/agents") or []
        if isinstance(agents, list):
            for a in agents:
                if isinstance(a, dict):
                    self._id_cache[a.get("name", "")] = a.get("id", "")
        return self._id_cache.get(name, name)

    def _heartbeat(self):
        """Auto-heartbeat on read operations. Best-effort, never blocks."""
        if not self.user:
            return
        try:
            aid = self._resolve(self.user)
            self._req("PUT", f"/api/agents/{aid}/heartbeat",
                      {"status_text": "active"}, timeout=3)
        except SystemExit:
            pass
        except Exception:
            pass

    # ── Commands ─────────────────────────────────────────────────────────────

    def health(self):
        return self._req("GET", "/health")

    def register(self, caps=None):
        self._need_user()
        body: dict = {"name": self.user}
        if caps:
            body["capabilities"] = [c.strip() for c in caps.split(",")]
        return self._req("POST", "/api/agents", body)

    def unregister(self):
        self._need_user()
        aid = self._resolve(self.user)
        return self._req("DELETE", f"/api/agents/{aid}")

    def heartbeat(self, status_text=None):
        self._need_user()
        aid = self._resolve(self.user)
        body: dict = {}
        if status_text:
            body["status_text"] = status_text
        return self._req("PUT", f"/api/agents/{aid}/heartbeat", body)

    def agents(self):
        self._heartbeat()
        return self._req("GET", "/api/agents")

    def discover(self, skill=None, tag=None):
        self._heartbeat()
        params = []
        if skill:
            params.append(f"skill={urllib.parse.quote(skill)}")
        if tag:
            params.append(f"tag={urllib.parse.quote(tag)}")
        qs = "&".join(params)
        path = f"/api/agents/discover?{qs}" if qs else "/api/agents"
        return self._req("GET", path)

    def send(self, to, content, importance=None, thread_id=None):
        self._need_user()
        self._heartbeat()
        body: dict = {"from": self.user, "content": content}
        if to.startswith("channel:"):
            body["channel"] = to[8:]
        else:
            body["to"] = to
        if importance:
            body["importance"] = importance
        if thread_id:
            body["thread_id"] = int(thread_id)
        return self._req("POST", "/api/messages", body)

    def broadcast(self, content, importance=None):
        self._need_user()
        self._heartbeat()
        body: dict = {"from": self.user, "content": content}
        if importance:
            body["importance"] = importance
        return self._req("POST", "/api/messages/broadcast", body)

    def _mark_read_msgs(self, msgs):
        """Auto-mark returned messages as read. Best-effort."""
        if not msgs or not isinstance(msgs, list):
            return
        aid = self._resolve(self.user)
        for msg in msgs:
            if isinstance(msg, dict) and "id" in msg:
                try:
                    self._req("POST", f"/api/messages/{msg['id']}/read",
                              {"agent_id": aid})
                except Exception:
                    pass

    def inbox(self, unread=False):
        self._need_user()
        self._heartbeat()
        aid = self._resolve(self.user)
        params = ["limit=50"]
        if unread:
            params.append("unread=true")
        msgs = self._req("GET", f"/api/agents/{aid}/inbox?{'&'.join(params)}")
        self._mark_read_msgs(msgs)
        return msgs

    def poll(self, timeout=60, all_=False, force=False):
        """Block until new unread message arrives or timeout.
        Loops in 55s server-poll chunks because backend caps at 60s.
        Auto-marks returned messages as read.
        Protected by fcntl.flock — one poll per agent."""
        import time

        self._need_user()
        aid = self._resolve(self.user)

        lock_fd = _lock_acquire(self.user, force=force)

        def _cleanup(*_args):
            try:
                _lock_release(lock_fd)
            except Exception:
                pass
            os._exit(1)
        signal.signal(signal.SIGTERM, _cleanup)
        signal.signal(signal.SIGINT, _cleanup)

        try:
            deadline = time.monotonic() + timeout

            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    print(
                        f"Error: poll timed out after {timeout}s with no messages.\n"
                        f"  This is normal — start a new poll to keep waiting.",
                        file=sys.stderr,
                    )
                    sys.exit(1)

                poll_sec = min(int(remaining), 55)
                params = f"timeout={poll_sec}"
                if all_:
                    params += "&all=true"
                msgs = self._poll_req(f"/api/agents/{aid}/poll?{params}",
                                      timeout=poll_sec + 5)
                if msgs and isinstance(msgs, list) and len(msgs) > 0:
                    self._mark_read_msgs(msgs)
                    return msgs
                # No messages in this chunk — loop again if time remains
        finally:
            _lock_release(lock_fd)

    def watch(self, interval=60, max_unread=50):
        """Background notification listener. Periodically checks for unread messages,
        prints one line per new message. Never marks anything as read.
        Never exits (until killed). Zero CPU when sleeping.

        Agent runs EITHER watch OR poll — never both. Watch is for live notification,
        poll is for actually reading messages. They share a lock to enforce this.

        How it works:
        - Fetches unread inbox periodically (every N seconds)
        - Filters out self-messages and already-emitted (id <= last_seen_id)
        - Prints one-line notification per new message
        - Saves last_seen_id to state file (survives restarts)
        - Sleeps until next cycle

        Startup behavior:
        - If > max_unread → refuse to start, exit 1
        - If 11-max_unread → show all with header
        - If 1-10 → show all silently
        - If 0 → silent
        """

        self._need_user()
        aid = self._resolve(self.user)

        self._heartbeat()

        lock_fd = _lock_acquire(self.user, force=False)
        _dbg("lock acquired")

        # Signal handler: save state then exit
        def _cleanup(*_args):
            # Cannot call _dbg here — reentrant write risk
            try:
                tmp = state_file + ".tmp"
                with open(tmp, "w") as sf:
                    sf.write(str(last_seen_id))
                os.rename(tmp, state_file)
            except Exception:
                pass
            try:
                _lock_release(lock_fd)
            except Exception:
                pass
            os._exit(0)
        signal.signal(signal.SIGTERM, _cleanup)
        signal.signal(signal.SIGINT, _cleanup)

        try:
            # Name resolution cache
            name_map = {}
            cycle_count = 0

            def _refresh_name_map():
                nonlocal name_map
                agents_raw = self._poll_req("/api/agents", timeout=10)
                if agents_raw and isinstance(agents_raw, list):
                    name_map.clear()
                    for a in agents_raw:
                        name_map[a.get("id", "")] = a.get("name", a.get("id", ""))
                    _dbg(f"name_map: {len(name_map)} agents")
                else:
                    _dbg("name_map refresh failed")

            _refresh_name_map()

            def _print_msg(m):
                mid = m.get("id", "?")
                from_id = m.get("from_agent", "")
                from_name = name_map.get(from_id, from_id[:8]) if from_id else "?"
                ts = time.strftime("%H:%M:%S")
                ch = m.get("channel_id") or m.get("channel_name")
                content = (m.get("content") or "").replace("\n", " ")[:120]
                parts = [f"[MSG] ts={ts} id={mid} from={from_name}"]
                if ch:
                    parts.append(f"channel={ch}")
                line = " ".join(parts) + f": {content}"
                sys.stdout.write(line + "\n")
                sys.stdout.flush()
                _dbg(f"emitted msg id={mid}")

            # State file: last_seen_id for dedup across restarts
            state_dir = os.path.join(os.path.expanduser("~"), ".agent-comm", "state")
            os.makedirs(state_dir, exist_ok=True)
            state_file = os.path.join(state_dir, f"{self.user}.watch.state")
            last_seen_id = 0
            try:
                with open(state_file, "r") as sf:
                    last_seen_id = int(sf.read().strip())
                    _dbg(f"loaded last_seen_id={last_seen_id}")
            except (FileNotFoundError, ValueError):
                _dbg("no state file, starting from 0")

            def _save_state():
                try:
                    tmp = state_file + ".tmp"
                    with open(tmp, "w") as sf:
                        sf.write(str(last_seen_id))
                    os.rename(tmp, state_file)
                    _dbg(f"saved last_seen_id={last_seen_id}")
                except Exception as e:
                    _dbg(f"state save failed: {e}")

            # ── Startup ─────────────────────────────────────────────────────
            sys.stdout.write(f"[WATCH] Started for {self.user}, interval={interval}s\n")
            sys.stdout.flush()

            unread = self._poll_req(
                f"/api/agents/{aid}/inbox?unread=true&limit=200", timeout=30)

            if unread and isinstance(unread, list):
                # Filter self-messages
                foreign = [m for m in unread if m.get("from_agent") != aid]
                # Filter already-seen
                new_msgs = [m for m in foreign if m.get("id", 0) > last_seen_id]
                # Sort ascending by id
                new_msgs.sort(key=lambda m: m.get("id", 0))

                _dbg(f"startup: {len(unread)} inbox, {len(foreign)} foreign, {len(new_msgs)} new")

                if len(new_msgs) > max_unread:
                    sys.stderr.write(
                        f"Error: too many unread messages ({len(new_msgs)}). "
                        f"Clear your inbox first: ac read-all or ac inbox\n")
                    sys.stderr.flush()
                    os._exit(1)
                elif len(new_msgs) > 10:
                    sys.stdout.write(
                        f"[WATCH] {len(new_msgs)} unread messages (showing all)\n")
                    sys.stdout.flush()
                    displayed = new_msgs
                    for m in displayed:
                        _print_msg(m)
                    last_seen_id = max(m.get("id", 0) for m in displayed)
                elif len(new_msgs) > 0:
                    displayed = new_msgs
                    for m in displayed:
                        _print_msg(m)
                    last_seen_id = max(m.get("id", 0) for m in displayed)
                else:
                    _dbg("startup: no new unread messages")

                _save_state()
            else:
                _dbg("startup: inbox empty or fetch failed")

            sys.stdout.write("[WATCH] Listening...\n")
            sys.stdout.flush()

            # ── Main Loop ───────────────────────────────────────────────────
            consecutive_failures = 0

            while True:
                time.sleep(interval)
                cycle_count += 1

                self._heartbeat()

                if cycle_count % 10 == 0:
                    _refresh_name_map()

                _dbg(f"cycle {cycle_count}: fetching unread")

                unread = self._poll_req(
                    f"/api/agents/{aid}/inbox?unread=true&limit=200", timeout=30)

                if unread is None:
                    consecutive_failures += 1
                    if consecutive_failures == 1:
                        _dbg("fetch failed, will retry")
                    elif consecutive_failures % 10 == 0:
                        _dbg(f"still failing ({consecutive_failures} attempts)")
                    continue

                if consecutive_failures > 0:
                    _dbg(f"reconnected after {consecutive_failures} failures")
                    consecutive_failures = 0

                if not isinstance(unread, list) or len(unread) == 0:
                    _dbg("no unread messages")
                    continue

                # Filter self + already-seen, sort ascending
                new_msgs = [m for m in unread
                            if m.get("from_agent") != aid
                            and m.get("id", 0) > last_seen_id]
                new_msgs.sort(key=lambda m: m.get("id", 0))

                if new_msgs:
                    _dbg(f"{len(new_msgs)} new messages")
                    for m in new_msgs:
                        _print_msg(m)
                        last_seen_id = m.get("id", last_seen_id)
                    _save_state()
                else:
                    _dbg(f"{len(unread)} unread but all self/seen")

        finally:
            _dbg("releasing lock")
            _lock_release(lock_fd)

    def ask(self, to, content, timeout=120):
        """Send a message and wait for a reply from the target agent.

        Uses inbox-check loop (no flock) so it coexists with a running watch.
        1. Check if target is online — fail immediately if not
        2. Send message to target
        3. Loop: fetch unread inbox, match reply by UUID, mark ONLY match read
        4. Return the reply
        """
        import time

        self._need_user()

        # Check if target is online
        target_id = self._resolve(to)
        if target_id == to:
            print(f"Error: agent \"{to}\" is not registered", file=sys.stderr)
            sys.exit(1)
        agents = self._req("GET", "/api/agents") or []
        target_agent = None
        for a in agents:
            if isinstance(a, dict) and a.get("id") == target_id:
                target_agent = a
                break
        if not target_agent:
            print(f"Error: agent \"{to}\" is not registered", file=sys.stderr)
            sys.exit(1)
        if target_agent.get("status") not in ("online", "idle"):
            print(f"Error: agent \"{to}\" is offline (status: {target_agent.get('status')})", file=sys.stderr)
            sys.exit(1)

        # Send the message
        sent = self.send(to, content)
        if not sent:
            return None

        sent_id = sent.get("id")
        aid = self._resolve(self.user)
        deadline = time.monotonic() + timeout

        # Inbox-check loop: no flock, coexists with watch
        _timed_out = False
        def _sigterm(*_a):
            nonlocal _timed_out
            _timed_out = True
        signal.signal(signal.SIGTERM, _sigterm)

        while not _timed_out:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                print("No reply received (timeout)", file=sys.stderr)
                sys.exit(1)

            inbox = self._poll_req(
                f"/api/agents/{aid}/inbox?unread=true&limit=50", timeout=10)

            if inbox and isinstance(inbox, list):
                for msg in inbox:
                    if (isinstance(msg, dict)
                            and msg.get("from_agent") == target_id
                            and msg.get("id") != sent_id):
                        self.mark_read(msg["id"])
                        return msg

            time.sleep(5)

        sys.exit(1)

    def mark_read(self, msg_id):
        self._need_user()
        aid = self._resolve(self.user)
        return self._req("POST", f"/api/messages/{msg_id}/read",
                         {"agent_id": aid})

    def read_all(self):
        self._need_user()
        aid = self._resolve(self.user)
        return self._req("POST", f"/api/agents/{aid}/read-all")

    def channels(self):
        self._heartbeat()
        return self._req("GET", "/api/channels")

    def channel(self, name):
        self._heartbeat()
        return self._req("GET", f"/api/channels/{urllib.parse.quote(name)}")

    def join(self, name):
        self._need_user()
        aid = self._resolve(self.user)
        return self._req("POST", f"/api/channels/{urllib.parse.quote(name)}/join",
                         {"agent_id": aid})

    def leave(self, name):
        self._need_user()
        aid = self._resolve(self.user)
        return self._req("POST", f"/api/channels/{urllib.parse.quote(name)}/leave",
                         {"agent_id": aid})

    def create_channel(self, name, description=None):
        self._need_user()
        self._heartbeat()
        aid = self._resolve(self.user)
        body: dict = {"name": name, "created_by": aid}
        if description:
            body["description"] = description
        return self._req("POST", "/api/channels", body)

    def msg_edit(self, msg_id, content):
        self._need_user()
        aid = self._resolve(self.user)
        return self._req("PATCH", f"/api/messages/{msg_id}",
                         {"agent_id": aid, "content": content})

    def msg_delete(self, msg_id):
        self._need_user()
        aid = self._resolve(self.user)
        return self._req("DELETE", f"/api/messages/{msg_id}",
                         {"agent_id": aid})

    def read_status(self, msg_id):
        self._heartbeat()
        return self._req("GET", f"/api/messages/{msg_id}/read-status")

    def thread(self, msg_id):
        self._heartbeat()
        msgs = self._req("GET", f"/api/messages/{msg_id}/thread")
        self._mark_read_msgs(msgs)
        return msgs

    def state_set(self, ns, key, value, ttl=None):
        self._need_user()
        self._heartbeat()
        aid = self._resolve(self.user)
        body: dict = {"value": value, "updated_by": aid}
        if ttl:
            body["ttl_seconds"] = int(ttl)
        return self._req("POST",
                         f"/api/state/{urllib.parse.quote(ns)}/{urllib.parse.quote(key)}",
                         body)

    def state_get(self, ns, key=None):
        self._heartbeat()
        if key:
            return self._req("GET",
                             f"/api/state/{urllib.parse.quote(ns)}/{urllib.parse.quote(key)}")
        return self._req("GET",
                         f"/api/state?namespace={urllib.parse.quote(ns)}")

    def state_delete(self, ns, key):
        self._need_user()
        return self._req("DELETE",
                         f"/api/state/{urllib.parse.quote(ns)}/{urllib.parse.quote(key)}")

    def feed(self, agent=None, type_=None, limit=20):
        params = [f"limit={limit}"]
        if agent:
            params.append(f"agent={urllib.parse.quote(agent)}")
        if type_:
            params.append(f"type={urllib.parse.quote(type_)}")
        return self._req("GET", f"/api/feed?{'&'.join(params)}")

    def stuck(self):
        return self._req("GET", "/api/stuck")

    def overview(self):
        return self._req("GET", "/api/overview")



# ── Output ───────────────────────────────────────────────────────────────────

def output(data):
    """Pretty-print JSON to stdout."""
    if data is not None:
        print(json.dumps(data, indent=2, ensure_ascii=False))


# ── CLI ──────────────────────────────────────────────────────────────────────

def main():
    p = argparse.ArgumentParser(
        prog="ac",
        description="agent-comm CLI client",
    )
    p.add_argument("--auto-register", action="store_true",
                   help="Auto-register before first command")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("health", help="Server health check")

    reg = sub.add_parser("register", help="Register this agent")
    reg.add_argument("--caps", help="Comma-separated capabilities")

    sub.add_parser("unregister", help="Unregister this agent")

    hb = sub.add_parser("heartbeat", help="Send heartbeat")
    hb.add_argument("--status", help="Status text")

    sub.add_parser("agents", help="List all agents")

    disc = sub.add_parser("discover", help="Discover agents by skill/tag")
    disc.add_argument("--skill", help="Filter by skill")
    disc.add_argument("--tag", help="Filter by tag")

    snd = sub.add_parser("send", help="Send a message")
    snd.add_argument("to", help="Recipient name/ID or channel:NAME")
    snd.add_argument("content", help="Message content")
    snd.add_argument("--importance", choices=["low", "normal", "high", "urgent"])
    snd.add_argument("--thread", type=int, help="Thread ID to reply to")

    bc = sub.add_parser("broadcast", help="Broadcast to all online agents")
    bc.add_argument("content", help="Message content")
    bc.add_argument("--importance", choices=["low", "normal", "high", "urgent"])

    ib = sub.add_parser("inbox", help="Check inbox (direct + channel)")
    ib.add_argument("--unread", action="store_true", help="Unread only")

    wa = sub.add_parser("watch", help="Background notification listener (one-line per msg, never exits)")
    wa.add_argument("--interval", type=int, default=60,
                    help="Polling interval in seconds (default 60)")
    wa.add_argument("--max-unread", type=int, default=50,
                    help="Max unread before refusing start (default 50)")
    wa.add_argument("--debug", action="store_true",
                    help="Print detailed cycle info to stderr")

    po = sub.add_parser("poll", help="Block until new unread message arrives")
    po.add_argument("--timeout", type=int, default=60,
                    help="Max wait seconds (default 60, no hard cap)")
    po.add_argument("--all", action="store_true",
                    help="Include already-read messages")
    po.add_argument("--force", action="store_true",
                    help="Force start even if another poll is running")

    ask = sub.add_parser("ask", help="Send message and wait for reply")
    ask.add_argument("to", help="Recipient agent name/ID")
    ask.add_argument("content", help="Message content")
    ask.add_argument("--timeout", type=int, default=120,
                     help="Max wait for reply in seconds (default 120)")

    mr = sub.add_parser("mark-read", help="Mark message as read")
    mr.add_argument("msg_id", type=int, help="Message ID")

    sub.add_parser("read-all", help="Mark all inbox messages as read")

    sub.add_parser("channels", help="List channels")

    ch = sub.add_parser("channel", help="Show channel details")
    ch.add_argument("name")

    jo = sub.add_parser("join", help="Join a channel")
    jo.add_argument("channel")

    le = sub.add_parser("leave", help="Leave a channel")
    le.add_argument("channel")

    cc = sub.add_parser("create-channel", help="Create a new channel")
    cc.add_argument("name", help="Channel name")
    cc.add_argument("--desc", help="Channel description")

    me = sub.add_parser("msg-edit", help="Edit a message (sender only)")
    me.add_argument("msg_id", type=int, help="Message ID")
    me.add_argument("content", help="New content")

    md = sub.add_parser("msg-delete", help="Delete a message (sender only)")
    md.add_argument("msg_id", type=int, help="Message ID")

    rs = sub.add_parser("read-status", help="Show who read a message")
    rs.add_argument("msg_id", type=int, help="Message ID")

    th = sub.add_parser("thread", help="Show message thread")
    th.add_argument("msg_id", type=int, help="Root message ID")

    st = sub.add_parser("state", help="State operations")
    st_sub = st.add_subparsers(dest="state_cmd")
    st_set = st_sub.add_parser("set", help="Set a state value")
    st_set.add_argument("namespace")
    st_set.add_argument("key")
    st_set.add_argument("value")
    st_set.add_argument("--ttl", type=int, help="TTL in seconds")
    st_get = st_sub.add_parser("get", help="Get state value(s)")
    st_get.add_argument("namespace")
    st_get.add_argument("key", nargs="?", default=None)
    st_del = st_sub.add_parser("delete", help="Delete a state value")
    st_del.add_argument("namespace")
    st_del.add_argument("key")

    fd = sub.add_parser("feed", help="Activity feed")
    fd.add_argument("--agent")
    fd.add_argument("--type")
    fd.add_argument("--limit", type=int, default=20)

    sub.add_parser("stuck", help="Show stuck agents")

    sub.add_parser("overview", help="Full system overview")

    args = p.parse_args()
    if not args.cmd:
        p.print_help()
        sys.exit(1)

    c = Client()
    c.auto_register = args.auto_register
    cmd = args.cmd

    if cmd == "health":
        output(c.health())
    elif cmd == "register":
        output(c.register(args.caps))
    elif cmd == "unregister":
        output(c.unregister())
    elif cmd == "heartbeat":
        output(c.heartbeat(args.status))
    elif cmd == "agents":
        output(c.agents())
    elif cmd == "discover":
        output(c.discover(args.skill, args.tag))
    elif cmd == "send":
        output(c.send(args.to, args.content, args.importance, args.thread))
    elif cmd == "broadcast":
        output(c.broadcast(args.content, args.importance))
    elif cmd == "inbox":
        output(c.inbox(args.unread))
    elif cmd == "poll":
        output(c.poll(args.timeout, args.all, args.force))
    elif cmd == "watch":
        global DEBUG
        DEBUG = args.debug
        c.watch(args.interval, args.max_unread)
    elif cmd == "ask":
        result = c.ask(args.to, args.content, args.timeout)
        if result:
            output(result)
        else:
            print("No reply received (timeout)", file=sys.stderr)
            sys.exit(1)
    elif cmd == "mark-read":
        output(c.mark_read(args.msg_id))
    elif cmd == "read-all":
        output(c.read_all())
    elif cmd == "channels":
        output(c.channels())
    elif cmd == "channel":
        output(c.channel(args.name))
    elif cmd == "join":
        output(c.join(args.channel))
    elif cmd == "leave":
        output(c.leave(args.channel))
    elif cmd == "create-channel":
        output(c.create_channel(args.name, args.desc))
    elif cmd == "msg-edit":
        output(c.msg_edit(args.msg_id, args.content))
    elif cmd == "msg-delete":
        output(c.msg_delete(args.msg_id))
    elif cmd == "read-status":
        output(c.read_status(args.msg_id))
    elif cmd == "thread":
        output(c.thread(args.msg_id))
    elif cmd == "state":
        if args.state_cmd == "set":
            output(c.state_set(args.namespace, args.key, args.value, args.ttl))
        elif args.state_cmd == "get":
            output(c.state_get(args.namespace, args.key))
        elif args.state_cmd == "delete":
            output(c.state_delete(args.namespace, args.key))
        else:
            st.print_help()
            sys.exit(1)
    elif cmd == "feed":
        output(c.feed(args.agent, args.type, args.limit))
    elif cmd == "stuck":
        output(c.stuck())
    elif cmd == "overview":
        output(c.overview())


if __name__ == "__main__":
    main()
